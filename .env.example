# ─────────────────────────────────────────────────────────────
#  Meta (Facebook) App credentials — developers.facebook.com
# ─────────────────────────────────────────────────────────────
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# Must EXACTLY match one of the "Valid OAuth Redirect URIs" in
# App settings → Products → Facebook Login → Settings.
# Local:  http://localhost:3000/api/meta/callback
# Public: https://<your-host>/api/meta/callback
META_REDIRECT_URI=http://localhost:3000/api/meta/callback

# Graph API version (v21.0+ recommended)
META_API_VERSION=v23.0

# Secret used to sign the session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "1" to force demo data even when connected (great for demos)
FORCE_DEMO=0
